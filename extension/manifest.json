{
  "manifest_version": 3,
  "name": "Keeper",
  "version": "3.10",
  "key": "",
  "description": "Сохраняет видео, звук и текст речи с открытой вкладки: YouTube, VK, Rutube, уроки курсов и ещё около 1000 сайтов",
  "permissions": ["tabs", "scripting", "cookies", "webRequest", "storage", "contextMenus", "notifications", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_title": "Keeper — видео, звук и текст с этой страницы", "default_icon": "icon.png" },
  "background": { "service_worker": "background.js", "type": "module" }
}
